# Database connection string (PostgreSQL)
DASHBOARDS_REPLICA_DSN=postgresql://postgres:password@localhost:5432/dashboards_dev

# Connection pool settings (optional)
DASHBOARDS_REPLICA_MIN_CONN=2
DASHBOARDS_REPLICA_MAX_CONN=20

# Redis Cache URL (optional - falls back safely to no-cache if unreachable)
REDIS_URL=redis://localhost:6379/0
